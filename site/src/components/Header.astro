---
// Main site header: navy row with the CTA, orange nav row, and the logo badge spanning both.
// Below 1100px it becomes one navy bar with phone, Book and a menu button that opens a full-screen orange menu.
interface Props { active?: string | null }
const { active = null } = Astro.props;
const nav = [
  { id: 'home', label: 'Home', href: '/' },
  { id: 'services', label: 'Services', href: '/services/' },
  { id: 'about', label: 'About', href: '/about/' },
  { id: 'reviews', label: 'Reviews', href: '/reviews/' },
  { id: 'faq', label: 'FAQ', href: '/faq/' },
  { id: 'contact', label: 'Contact', href: '/contact/' },
];
const mark = (id: string) => (id === active ? '#182B49' : 'transparent');
const logo = '/images/logo.webp';
---
<header style="position:sticky;top:0;z-index:20">
  <div style="background:#182B49">
    <div style="max-width:1200px;width:100%;box-sizing:border-box;margin:0 auto;padding:0 var(--padx);height:64px;display:flex;align-items:center;justify-content:space-between;gap:16px">
      <div class="m-only">
        <a href="/" style="display:block;line-height:0;flex:none"><img src={logo} alt="Foam War Parties" width="92" height="46" style="height:46px;width:auto;display:block;mix-blend-mode:lighten"></a>
        <div style="display:flex;align-items:center;gap:8px;flex:none">
          <a href="tel:+14175592347" aria-label="Call or text (417) 559-2347" style="width:44px;height:44px;border-radius:50%;background:rgba(255,255,255,.12);display:flex;align-items:center;justify-content:center"><svg width="22" height="22" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"></path></svg></a>
          <a href="/build-your-party/" style="background:#FF7518;color:#182B49;font-weight:800;text-decoration:none;padding:0 14px;height:44px;display:flex;align-items:center;border-radius:999px;font-size:15px;white-space:nowrap">Book Your Party</a>
          <button type="button" data-menu-open aria-label="Open menu" aria-expanded="false" aria-controls="site-menu" style="width:44px;height:44px;border-radius:12px;border:0;background:rgba(255,255,255,.12);cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;padding:0">
            <span style="width:22px;height:3px;background:#fff;border-radius:2px"></span>
            <span style="width:22px;height:3px;background:#fff;border-radius:2px"></span>
            <span style="width:22px;height:3px;background:#fff;border-radius:2px"></span>
          </button>
        </div>
      </div>
      <div class="d-only">
        <span></span>
        <div style="display:flex;align-items:center;gap:20px;flex:none">
          <div style="font-size:18px;white-space:nowrap"><span style="color:#fff;font-weight:800">Call or Text</span> <a href="tel:+14175592347" style="color:#0875D1;font-weight:800;text-decoration:none">(417) 559-2347</a></div>
          <a href="/build-your-party/" style="background:#FF7518;color:#182B49;font-weight:800;text-decoration:none;padding:16px 28px;border-radius:999px;font-size:18px;white-space:nowrap">Book Your Party</a>
        </div>
      </div>
    </div>
  </div>
  <div class="d-only">
    <div style="background:#FF7518">
      <nav aria-label="Main" style="max-width:1200px;width:100%;box-sizing:border-box;margin:0 auto;padding:0 var(--padx);height:64px;display:flex;align-items:center;justify-content:center;gap:clamp(20px,3vw,48px)">
        {nav.map((n) => (
          <a href={n.href} class="hv-nav" aria-current={n.id === active ? 'page' : undefined} style={`color:#182B49;text-decoration:none;font-weight:800;font-size:17px;white-space:nowrap;padding:6px 0;border-bottom:3px solid ${mark(n.id)}`}>{n.label}</a>
        ))}
      </nav>
    </div>
    <div style="position:absolute;left:0;right:0;top:12px;pointer-events:none;z-index:2">
      <div style="max-width:1200px;width:100%;box-sizing:border-box;margin:0 auto;padding:0 var(--padx)">
        <a href="/" style="display:inline-block;line-height:0;pointer-events:auto;background:#182B49;border:2px solid #fff;border-radius:16px;padding:6px;box-shadow:0 6px 18px rgba(24,43,73,.4)"><img src={logo} alt="Foam War Parties" width="176" height="88" style="height:88px;width:auto;display:block;mix-blend-mode:lighten"></a>
      </div>
    </div>
  </div>
  <div id="site-menu" class="menu-overlay" data-menu hidden role="dialog" aria-modal="true" aria-label="Menu" style="position:fixed;inset:0;background:#FF7518;z-index:30;display:flex;flex-direction:column;padding:12px 16px 32px;overflow:auto">
    <div style="display:flex;justify-content:space-between;align-items:center;min-height:60px">
      <a href="/" style="display:block;line-height:0"><img src={logo} alt="Foam War Parties" width="92" height="46" style="height:46px;width:auto;display:block;mix-blend-mode:lighten"></a>
      <button type="button" data-menu-close aria-label="Close menu" style="width:44px;height:44px;border-radius:12px;border:0;background:#182B49;color:#fff;font-size:28px;cursor:pointer;line-height:1">×</button>
    </div>
    <nav aria-label="Mobile" style="display:flex;flex-direction:column;margin-top:16px;flex:1">
      {nav.map((n) => (
        <a href={n.href} aria-current={n.id === active ? 'page' : undefined} style={`color:#182B49;text-decoration:none;font-family:'Archivo Black',sans-serif;text-transform:uppercase;font-size:30px;padding:16px 0;border-bottom:1px solid rgba(24,43,73,.25);border-left:6px solid ${mark(n.id)};padding-left:14px`}>{n.label}</a>
      ))}
    </nav>
    <div style="display:flex;flex-direction:column;gap:12px;margin-top:24px">
      <a href="tel:+14175592347" style="color:#182B49;text-align:center;font-weight:800;font-size:18px;text-decoration:none;padding:16px 28px;border:2px solid #182B49;border-radius:14px">Call or Text (417) 559-2347</a>
      <a href="/build-your-party/" style="background:#182B49;color:#fff;text-align:center;font-weight:800;font-size:18px;text-decoration:none;padding:16px 28px;border-radius:14px;text-transform:uppercase">Book Your Party</a>
    </div>
  </div>
</header>
