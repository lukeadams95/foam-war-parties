---
// Simplified header for the /birthday-parties ad landing page: no nav, just logo, phone and Get My Quote.
---
<header style="position:sticky;top:0;z-index:20;background:#182B49">
  <div style="max-width:1200px;width:100%;box-sizing:border-box;margin:0 auto;padding:0 var(--padx);height:72px;display:flex;align-items:center;justify-content:space-between;gap:16px">
    <a href="/birthday-parties/" style="display:block;line-height:0;flex:none"><img src="/images/logo.webp" alt="Foam War Parties" width="92" height="46" style="height:46px;width:auto;display:block;mix-blend-mode:lighten"></a>
    <div style="display:flex;align-items:center;gap:20px;flex:none">
      <div class="d-only"><div style="font-size:18px;white-space:nowrap"><span style="color:#fff;font-weight:800">Call or Text</span> <a href="tel:+14175592347" style="color:#0875D1;font-weight:800;text-decoration:none">(417) 559-2347</a></div></div>
      <div class="m-only"><a href="tel:+14175592347" aria-label="Call or text (417) 559-2347" style="width:44px;height:44px;border-radius:50%;background:rgba(255,255,255,.12);display:flex;align-items:center;justify-content:center"><svg width="22" height="22" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"></path></svg></a></div>
      <a href="#quote" style="background:#FF7518;color:#182B49;font-weight:800;text-decoration:none;padding:16px 28px;border-radius:999px;font-size:18px;white-space:nowrap">Get My Quote</a>
    </div>
  </div>
</header>
