---
const links = [
  ['Home', '/'], ['Services', '/services/'], ['About', '/about/'], ['Reviews', '/reviews/'],
  ['FAQ', '/faq/'], ['Contact', '/contact/'], ['Privacy Policy', '/privacy/'], ['Terms of Service', '/terms/'],
];
---
<footer style="background:#182B49;color:#fff;padding:56px 0 32px">
  <div style="max-width:1200px;width:100%;box-sizing:border-box;margin:0 auto;padding:0 var(--padx);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:32px">
    <div style="display:flex;flex-direction:column;gap:12px">
      <img src="/images/logo.webp" alt="Foam War Parties" width="260" height="130" loading="lazy" style="width:260px;max-width:100%;height:auto;border-radius:12px;display:block">
      <div style="font-size:18px">Bringing Epic Foam Battles to You.</div>
    </div>
    <div style="display:flex;flex-direction:column;gap:10px;font-size:18px;line-height:1.5">
      <div>Based in Forsyth, Missouri · Serving Branson, Springfield &amp; Southwest Missouri</div>
      <a href="tel:+14175592347" style="color:#fff;font-weight:700;text-decoration:none;font-size:20px">(417) 559-2347</a>
    </div>
    <nav aria-label="Footer" style="display:grid;grid-template-columns:1fr 1fr;gap:10px 16px;font-size:18px;align-content:start">
      {links.map(([label, href]) => <a href={href} style="color:#fff;text-decoration:none">{label}</a>)}
    </nav>
  </div>
  <div style="max-width:1200px;width:100%;box-sizing:border-box;margin:36px auto 0;padding:0 var(--padx)">
    <div style="padding-top:20px;border-top:1px solid #3a4d6b;font-size:15px;color:#cbd5e5">© 2026 FoamBattleParties LLC. All rights reserved.</div>
  </div>
</footer>
