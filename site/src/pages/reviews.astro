---
import Base from '../layouts/Base.astro';
---
<Base title="Reviews | Foam War Parties" description="Share your Foam War Parties experience. Call or text (417) 559-2347 after your foam battle." active={"reviews"}>
<section style="position:relative;background:#182B49;color:#fff;padding:20px 0 36px;overflow:hidden;min-height:300px;display:flex;align-items:center"><img src="/images/foam-lineart.png" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;filter:invert(1);mix-blend-mode:screen;opacity:.13">
<div style="position:absolute;inset:0;background:radial-gradient(ellipse 60% 55% at 50% 38%,rgba(14,26,46,.92) 0%,rgba(14,26,46,.6) 55%,rgba(14,26,46,0) 100%)">
</div>
<div style="position:relative;max-width:1200px;width:100%;box-sizing:border-box;margin:0 auto;padding:0 var(--padx);width:100%;text-align:center">
<h1 style="font-family:'Archivo Black',sans-serif;font-size:clamp(40px,7vw,64px);line-height:1;margin:0 0 14px;text-transform:uppercase;text-shadow:0 3px 6px rgba(10,20,38,.6)">Had a <span style="color:#FF7518;text-shadow:0 0 6px rgba(255,117,24,.28),0 0 12px rgba(255,117,24,.16)">Blast?</span></h1>
<p style="font-size:clamp(18px,2.4vw,24px);max-width:720px;margin:0 auto;line-height:1.4;text-wrap:pretty;text-shadow:0 2px 6px rgba(10,20,38,.85),0 0 16px rgba(10,20,38,.7)">After your foam battle, tell us how it went.</p>
</div>
</section>
<section style="background:#F3F4F6;color:#182B49;padding:72px 0">
<div style="max-width:1200px;width:100%;box-sizing:border-box;margin:0 auto;padding:0 var(--padx)">
<div style="text-align:center;margin-bottom:14px">
<div style="display:inline-block;background:#0875D1;color:#fff;font-weight:700;font-size:14px;letter-spacing:.04em;padding:8px 16px;border-radius:999px;text-transform:uppercase">Leave a Review</div>
</div>
<h2 style="font-family:'Archivo Black',sans-serif;font-size:clamp(34px,6vw,60px);text-transform:uppercase;margin:0 0 16px;line-height:1;text-align:center;color:#182B49;text-wrap:balance">Tell Us About <span style="color:#FF7518">Your Party</span></h2>
<p style="font-size:18px;max-width:720px;margin:0 auto 32px;line-height:1.5;text-align:center;text-wrap:pretty">We'd love to hear about your party. Call or text us and tell us how it went. We'll share family reviews here as they come in.</p>
<div style="display:flex;flex-wrap:wrap;gap:14px;justify-content:center"><a href="tel:+14175592347" style="background:#FF7518;color:#182B49;font-weight:800;text-decoration:none;text-align:center;padding:16px 28px;border-radius:14px;font-size:18px;text-transform:uppercase">Call or Text (417) 559-2347</a><a href="/contact/" style="background:#fff;color:#182B49;font-weight:800;text-decoration:none;text-align:center;padding:16px 28px;border-radius:14px;font-size:18px;text-transform:uppercase;border:2px solid #182B49">Send Us a Message</a>
</div>
</div>
</section>
<section style="position:relative;color:#fff;padding:calc(80px + clamp(40px,5vw,84px)) 0 80px;text-align:center;z-index:1">
<div style="position:absolute;left:0;right:0;top:calc(-1 * clamp(40px,5vw,84px));bottom:0;background:#0875D1;overflow:hidden;pointer-events:none;-webkit-mask:url(/images/cloud-mask-up.png) top/100% clamp(40px,5vw,84px) no-repeat,linear-gradient(#000,#000) bottom/100% calc(100% - clamp(40px,5vw,84px) + 4px) no-repeat;mask:url(/images/cloud-mask-up.png) top/100% clamp(40px,5vw,84px) no-repeat,linear-gradient(#000,#000) bottom/100% calc(100% - clamp(40px,5vw,84px) + 4px) no-repeat"><img src="/images/foam-lineart.png" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;filter:invert(1);mix-blend-mode:screen;opacity:.16">
</div>
<div style="position:relative;max-width:1200px;width:100%;box-sizing:border-box;margin:0 auto;padding:0 var(--padx)">
<h2 style="text-shadow:0 3px 6px rgba(10,20,38,.45);font-family:'Archivo Black',sans-serif;font-size:clamp(34px,6vw,60px);text-transform:uppercase;margin:0 0 32px;line-height:1;text-wrap:balance">Your Party Could <span style="color:#FF7518">Be Next</span></h2>
<div style="display:flex;flex-wrap:wrap;gap:14px;justify-content:center"><a href="/build-your-party/" style="background:#FF7518;color:#182B49;font-weight:800;text-decoration:none;padding:16px 28px;border-radius:14px;font-size:18px;text-transform:uppercase">Build Your Party</a><a href="tel:+14175592347" style="background:#fff;color:#182B49;font-weight:800;text-decoration:none;padding:16px 28px;border-radius:14px;font-size:18px">Call or Text (417) 559-2347</a>
</div>
</div>
</section>
</Base>
