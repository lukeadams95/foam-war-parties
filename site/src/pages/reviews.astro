---
import Base from '../layouts/Base.astro';
---
<Base title="Reviews | Foam War Parties" description="See what parents are saying about Foam War Parties, and leave us a review after your foam battle." active={"reviews"}>
<section style="position:relative;background:#182B49;color:#fff;padding:20px 0 36px;overflow:hidden;min-height:300px;display:flex;align-items:center"><img src="/images/foam-lineart.png" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;filter:invert(1);mix-blend-mode:screen;opacity:.13">
<div style="position:absolute;inset:0;background:radial-gradient(ellipse 60% 55% at 50% 38%,rgba(14,26,46,.92) 0%,rgba(14,26,46,.6) 55%,rgba(14,26,46,0) 100%)">
</div>
<div style="position:relative;max-width:1200px;width:100%;box-sizing:border-box;margin:0 auto;padding:0 var(--padx);width:100%;text-align:center">
<h1 style="font-family:'Archivo Black',sans-serif;font-size:clamp(40px,7vw,64px);line-height:1;margin:0 0 14px;text-transform:uppercase;text-shadow:0 3px 6px rgba(10,20,38,.6)">What Parents Are <span style="color:#FF7518;text-shadow:0 0 6px rgba(255,117,24,.28),0 0 12px rgba(255,117,24,.16)">Saying</span></h1>
<p style="font-size:clamp(18px,2.4vw,24px);max-width:720px;margin:0 auto;line-height:1.4;text-wrap:pretty;text-shadow:0 2px 6px rgba(10,20,38,.85),0 0 16px rgba(10,20,38,.7)">Real reviews from real foam battles.</p>
</div>
</section>
<section style="background:#182B49;color:#fff;padding:72px 0">
<div style="max-width:1200px;width:100%;box-sizing:border-box;margin:0 auto;padding:0 var(--padx)">
<div style="font-family:'Archivo Black',sans-serif;font-size:clamp(34px,6vw,60px);text-transform:uppercase;line-height:1;text-align:center;color:#fff;text-shadow:0 3px 6px rgba(10,20,38,.45);margin:0 0 0px">Coming <span style="color:#FF7518">Soon</span>
</div>
</div>
</section>
<section style="background:#F3F4F6;color:#182B49;padding:72px 0">
<div style="max-width:1200px;width:100%;box-sizing:border-box;margin:0 auto;padding:0 var(--padx)">
<div style="text-align:center;margin-bottom:14px">
<div style="display:inline-block;background:#0875D1;color:#fff;font-weight:700;font-size:14px;letter-spacing:.04em;padding:8px 16px;border-radius:999px;text-transform:uppercase">Leave a Review</div>
</div>
<h2 style="font-family:'Archivo Black',sans-serif;font-size:clamp(34px,6vw,60px);text-transform:uppercase;margin:0 0 16px;line-height:1;text-align:center;color:#182B49;text-wrap:balance">Had a <span style="color:#FF7518">Blast?</span></h2>
<p style="font-size:18px;max-width:720px;margin:0 auto 32px;line-height:1.5;text-align:center;text-wrap:pretty">We'd love to hear about your party! Your review helps other families find us.</p>
<div style="display:flex;justify-content:center"><a href="#" data-todo="Replace with the Google review link (target=_blank rel=noopener)" style="background:#FF7518;color:#182B49;font-weight:800;text-decoration:none;text-align:center;padding:16px 28px;border-radius:14px;font-size:18px;text-transform:uppercase">Leave Us a Google Review</a>
</div>
</div>
</section>
<section style="position:relative;z-index:1;background:#182B49;color:#fff;padding:clamp(100px,10vw,140px) 0 72px">
<div style="position:absolute;left:0;right:0;bottom:100%;margin-bottom:-1px;height:clamp(40px,5vw,84px);background:#182B49;z-index:2;-webkit-mask:url(/images/cloud-mask-up.png) center bottom/100% 100% no-repeat;mask:url(/images/cloud-mask-up.png) center bottom/100% 100% no-repeat">
</div>
<div style="position:absolute;inset:0;overflow:hidden;pointer-events:none"><svg viewBox="0 0 250 120" style="position:absolute;pointer-events:none;width:360px;left:-70px;top:90px;opacity:.07;transform:rotate(-14deg)" fill="#fff"><rect x="70" y="32" width="160" height="16" rx="8"></rect><rect x="218" y="27" width="24" height="26" rx="5"></rect><rect x="14" y="42" width="140" height="34" rx="13"></rect><rect x="72" y="22" width="60" height="10" rx="4"></rect><rect x="34" y="70" width="22" height="42" rx="8" transform="rotate(-12 45 90)"></rect><circle cx="108" cy="84" r="19"></circle><rect x="150" y="70" width="8" height="18" rx="4"></rect></svg><svg viewBox="0 0 250 120" style="position:absolute;pointer-events:none;width:340px;right:-60px;top:110px;opacity:.08;transform:rotate(18deg) scaleX(-1)" fill="#fff"><rect x="70" y="32" width="160" height="16" rx="8"></rect><rect x="218" y="27" width="24" height="26" rx="5"></rect><rect x="14" y="42" width="140" height="34" rx="13"></rect><rect x="72" y="22" width="60" height="10" rx="4"></rect><rect x="34" y="70" width="22" height="42" rx="8" transform="rotate(-12 45 90)"></rect><circle cx="108" cy="84" r="19"></circle><rect x="150" y="70" width="8" height="18" rx="4"></rect></svg><svg viewBox="0 0 250 120" style="position:absolute;pointer-events:none;width:280px;left:-60px;bottom:90px;opacity:.07;transform:rotate(12deg)" fill="#fff"><rect x="70" y="32" width="160" height="16" rx="8"></rect><rect x="218" y="27" width="24" height="26" rx="5"></rect><rect x="14" y="42" width="140" height="34" rx="13"></rect><rect x="72" y="22" width="60" height="10" rx="4"></rect><rect x="34" y="70" width="22" height="42" rx="8" transform="rotate(-12 45 90)"></rect><circle cx="108" cy="84" r="19"></circle><rect x="150" y="70" width="8" height="18" rx="4"></rect></svg><svg viewBox="0 0 250 120" style="position:absolute;pointer-events:none;width:300px;right:6%;bottom:70px;opacity:.07;transform:rotate(-10deg) scaleX(-1)" fill="#fff"><rect x="70" y="32" width="160" height="16" rx="8"></rect><rect x="218" y="27" width="24" height="26" rx="5"></rect><rect x="14" y="42" width="140" height="34" rx="13"></rect><rect x="72" y="22" width="60" height="10" rx="4"></rect><rect x="34" y="70" width="22" height="42" rx="8" transform="rotate(-12 45 90)"></rect><circle cx="108" cy="84" r="19"></circle><rect x="150" y="70" width="8" height="18" rx="4"></rect></svg>
</div>
<div style="position:relative;max-width:1200px;width:100%;box-sizing:border-box;margin:0 auto;padding:0 var(--padx)">
<div style="text-align:center;margin-bottom:14px">
<div style="display:inline-block;background:#fff;color:#0875D1;font-weight:700;font-size:14px;letter-spacing:.04em;padding:8px 16px;border-radius:999px;text-transform:uppercase">Photo Gallery</div>
</div>
<h2 style="text-shadow:0 3px 6px rgba(10,20,38,.45);font-family:'Archivo Black',sans-serif;font-size:clamp(34px,6vw,60px);text-transform:uppercase;margin:0 0 40px;line-height:1;text-align:center;color:#fff;text-wrap:balance">From Our <span style="color:#FF7518">Battlefields</span></h2>
<div style="font-family:'Archivo Black',sans-serif;font-size:clamp(34px,6vw,60px);text-transform:uppercase;line-height:1;text-align:center;color:#fff;text-shadow:0 3px 6px rgba(10,20,38,.45);margin:0 0 0px">Coming <span style="color:#FF7518">Soon</span>
</div>
</div>
</section>
<section style="position:relative;color:#fff;padding:calc(80px + clamp(40px,5vw,84px)) 0 80px;text-align:center;z-index:1">
<div style="position:absolute;left:0;right:0;top:calc(-1 * clamp(40px,5vw,84px));bottom:0;background:#0875D1;overflow:hidden;pointer-events:none;-webkit-mask:url(/images/cloud-mask-up.png) top/100% clamp(40px,5vw,84px) no-repeat,linear-gradient(#000,#000) bottom/100% calc(100% - clamp(40px,5vw,84px) + 4px) no-repeat;mask:url(/images/cloud-mask-up.png) top/100% clamp(40px,5vw,84px) no-repeat,linear-gradient(#000,#000) bottom/100% calc(100% - clamp(40px,5vw,84px) + 4px) no-repeat"><img src="/images/foam-lineart.png" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;filter:invert(1);mix-blend-mode:screen;opacity:.16">
</div>
<div style="position:relative;max-width:1200px;width:100%;box-sizing:border-box;margin:0 auto;padding:0 var(--padx)">
<h2 style="text-shadow:0 3px 6px rgba(10,20,38,.45);font-family:'Archivo Black',sans-serif;font-size:clamp(34px,6vw,60px);text-transform:uppercase;margin:0 0 32px;line-height:1;text-wrap:balance">Your Party Could <span style="color:#FF7518">Be Next</span></h2>
<div style="display:flex;flex-wrap:wrap;gap:14px;justify-content:center"><a href="/build-your-party/" style="background:#FF7518;color:#182B49;font-weight:800;text-decoration:none;padding:16px 28px;border-radius:14px;font-size:18px;text-transform:uppercase">Build Your Party</a><a href="tel:+14175592347" style="background:#fff;color:#182B49;font-weight:800;text-decoration:none;padding:16px 28px;border-radius:14px;font-size:18px">Call or Text (417) 559-2347</a>
</div>
</div>
</section>
</Base>
