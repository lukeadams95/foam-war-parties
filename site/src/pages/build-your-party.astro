---
import Base from '../layouts/Base.astro';
---
<Base title="Build Your Foam War Party | Foam War Parties" description="Build your DIY rental or full-service foam war party." active={null} noindex>
<section style="position:relative;background:#182B49;color:#fff;padding:20px 0 36px;overflow:hidden;min-height:300px;display:flex;align-items:center"><img src="/images/foam-lineart.png" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;filter:invert(1);mix-blend-mode:screen;opacity:.13">
<div style="position:absolute;inset:0;background:radial-gradient(ellipse 60% 55% at 50% 38%,rgba(14,26,46,.92) 0%,rgba(14,26,46,.6) 55%,rgba(14,26,46,0) 100%)">
</div>
<div style="position:relative;max-width:1200px;width:100%;box-sizing:border-box;margin:0 auto;padding:0 var(--padx);text-align:center">
<h1 style="font-family:'Archivo Black',sans-serif;font-size:clamp(40px,7vw,64px);line-height:1;margin:0;text-transform:uppercase;color:#FF7518;text-shadow:0 3px 6px rgba(10,20,38,.6)">Build Your Party</h1>
</div>
</section>
</Base>
