<div style="aspect-ratio:4/3;border-radius:28px;background:repeating-linear-gradient(135deg,#dbeafe 0 16px,#c7dcf3 16px 32px);display:flex;flex-direction:column;gap:8px;align-items:center;justify-content:center;padding:24px;text-align:center">
