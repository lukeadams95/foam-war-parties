---
import Base from '../layouts/Base.astro';
---
<Base title="Contact Us | Foam War Parties" description="Request your foam war party. Call or text (417) 559-2347, or send us your party details. Based in Forsyth, serving Branson, Springfield and Southwest Missouri." active={"contact"}>
<section style="position:relative;background:#182B49;color:#fff;padding:20px 0 36px;overflow:hidden;min-height:300px;display:flex;align-items:center"><img src="/images/foam-lineart.png" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;filter:invert(1);mix-blend-mode:screen;opacity:.13">
<div style="position:absolute;inset:0;background:radial-gradient(ellipse 60% 55% at 50% 38%,rgba(14,26,46,.92) 0%,rgba(14,26,46,.6) 55%,rgba(14,26,46,0) 100%)">
</div>
<div style="position:relative;max-width:1200px;width:100%;box-sizing:border-box;margin:0 auto;padding:0 var(--padx);width:100%;text-align:center">
<h1 style="font-family:'Archivo Black',sans-serif;font-size:clamp(40px,7vw,64px);line-height:1;margin:0 0 14px;text-transform:uppercase;text-shadow:0 3px 6px rgba(10,20,38,.6)">Contact <span style="color:#FF7518;text-shadow:0 0 6px rgba(255,117,24,.28),0 0 12px rgba(255,117,24,.16)">Us</span></h1>
<p style="font-size:clamp(18px,2.4vw,24px);max-width:720px;margin:0 auto;line-height:1.4;text-wrap:pretty;text-shadow:0 2px 6px rgba(10,20,38,.85),0 0 16px rgba(10,20,38,.7)">Let's plan your foam battle.</p>
</div>
</section>
<section style="background:#F3F4F6;color:#182B49;padding:72px 0">
<div style="max-width:1200px;width:100%;box-sizing:border-box;margin:0 auto;padding:0 var(--padx)">
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:24px;align-items:start">
<div style="position:relative;margin-top:26px;background:#fff;border-radius:28px;padding:32px;border-top:10px solid #0875D1">
<div style="position:absolute;left:30px;right:30px;bottom:calc(100% + 9px);height:18px;overflow:hidden;display:flex;justify-content:center;pointer-events:none">
<div style="flex:none;width:36px;height:36px;border-radius:50%;background:#0875D1;margin-top:8px;">
</div>
<div style="flex:none;width:36px;height:36px;border-radius:50%;background:#0875D1;margin-top:3px;margin-left:-8px">
</div>
<div style="flex:none;width:36px;height:36px;border-radius:50%;background:#0875D1;margin-top:6px;margin-left:-8px">
</div>
<div style="flex:none;width:36px;height:36px;border-radius:50%;background:#0875D1;margin-top:0px;margin-left:-8px">
</div>
<div style="flex:none;width:36px;height:36px;border-radius:50%;background:#0875D1;margin-top:5px;margin-left:-8px">
</div>
<div style="flex:none;width:36px;height:36px;border-radius:50%;background:#0875D1;margin-top:1px;margin-left:-8px">
</div>
<div style="flex:none;width:36px;height:36px;border-radius:50%;background:#0875D1;margin-top:7px;margin-left:-8px">
</div>
<div style="flex:none;width:36px;height:36px;border-radius:50%;background:#0875D1;margin-top:3px;margin-left:-8px">
</div>
<div style="flex:none;width:36px;height:36px;border-radius:50%;background:#0875D1;margin-top:8px;margin-left:-8px">
</div>
</div>
<h2 style="font-family:'Archivo Black',sans-serif;font-size:clamp(34px,6vw,60px);text-transform:uppercase;margin:0 0 28px;line-height:1;color:#182B49;text-wrap:balance">Request Your <span style="color:#FF7518">Party</span></h2>
<form data-form style="display:flex;flex-direction:column;gap:20px">
<label style="display:flex;flex-direction:column;gap:8px;min-width:0"><span style="font-weight:800;font-size:18px">Full Name<span style="color:#FF7518">*</span></span><input name="name" type="text" required autocomplete="name" style="width:100%;box-sizing:border-box;height:56px;border:2px solid #d5dbe5;border-radius:14px;padding:0 16px;font-family:inherit;font-size:18px;color:#182B49;background:#fff"></label>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:20px">
<label style="display:flex;flex-direction:column;gap:8px;min-width:0"><span style="font-weight:800;font-size:18px">Phone<span style="color:#FF7518">*</span></span><input name="phone" type="tel" required autocomplete="tel" style="width:100%;box-sizing:border-box;height:56px;border:2px solid #d5dbe5;border-radius:14px;padding:0 16px;font-family:inherit;font-size:18px;color:#182B49;background:#fff"></label>
<label style="display:flex;flex-direction:column;gap:8px;min-width:0"><span style="font-weight:800;font-size:18px">Email<span style="color:#FF7518">*</span></span><input name="email" type="email" required autocomplete="email" style="width:100%;box-sizing:border-box;height:56px;border:2px solid #d5dbe5;border-radius:14px;padding:0 16px;font-family:inherit;font-size:18px;color:#182B49;background:#fff"></label>
</div>
<fieldset style="border:0;margin:0;padding:0;min-width:0"><legend style="padding:0;margin-bottom:8px"><span style="font-weight:800;font-size:18px">Preferred Contact Method<span style="color:#FF7518">*</span></span></legend>
<div style="display:flex;flex-wrap:wrap;gap:10px">
<label style="display:flex;align-items:center;gap:10px;background:#F3F4F6;border-radius:999px;padding:14px 20px;font-size:18px;font-weight:700;cursor:pointer"><input type="radio" name="contact_method" value="Text"  required style="width:20px;height:20px;margin:0;accent-color:#0875D1">Text</label>
<label style="display:flex;align-items:center;gap:10px;background:#F3F4F6;border-radius:999px;padding:14px 20px;font-size:18px;font-weight:700;cursor:pointer"><input type="radio" name="contact_method" value="Call"  required style="width:20px;height:20px;margin:0;accent-color:#0875D1">Call</label>
<label style="display:flex;align-items:center;gap:10px;background:#F3F4F6;border-radius:999px;padding:14px 20px;font-size:18px;font-weight:700;cursor:pointer"><input type="radio" name="contact_method" value="Email"  required style="width:20px;height:20px;margin:0;accent-color:#0875D1">Email</label>
</div></fieldset>
<fieldset style="border:0;margin:0;padding:0;min-width:0"><legend style="padding:0;margin-bottom:8px"><span style="font-weight:800;font-size:18px">Party Type<span style="color:#FF7518">*</span></span></legend>
<div style="display:flex;flex-wrap:wrap;gap:10px">
<label style="display:flex;align-items:center;gap:10px;background:#F3F4F6;border-radius:999px;padding:14px 20px;font-size:18px;font-weight:700;cursor:pointer"><input type="radio" name="party_type" value="DIY Equipment Rental"  required style="width:20px;height:20px;margin:0;accent-color:#0875D1">DIY Equipment Rental</label>
<label style="display:flex;align-items:center;gap:10px;background:#F3F4F6;border-radius:999px;padding:14px 20px;font-size:18px;font-weight:700;cursor:pointer"><input type="radio" name="party_type" value="Full-Service Party"  required style="width:20px;height:20px;margin:0;accent-color:#0875D1">Full-Service Party</label>
<label style="display:flex;align-items:center;gap:10px;background:#F3F4F6;border-radius:999px;padding:14px 20px;font-size:18px;font-weight:700;cursor:pointer"><input type="radio" name="party_type" value="Not Sure Yet"  required style="width:20px;height:20px;margin:0;accent-color:#0875D1">Not Sure Yet</label>
</div></fieldset>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:20px">
<label style="display:flex;flex-direction:column;gap:8px;min-width:0"><span style="font-weight:800;font-size:18px">Event Date</span><input name="event_date" type="date" style="width:100%;box-sizing:border-box;height:56px;border:2px solid #d5dbe5;border-radius:14px;padding:0 16px;font-family:inherit;font-size:18px;color:#182B49;background:#fff"></label>
<label style="display:flex;flex-direction:column;gap:8px;min-width:0"><span style="font-weight:800;font-size:18px">Number of Participants</span><input name="participants" type="number" min="1" style="width:100%;box-sizing:border-box;height:56px;border:2px solid #d5dbe5;border-radius:14px;padding:0 16px;font-family:inherit;font-size:18px;color:#182B49;background:#fff"></label>
</div>
<label style="display:flex;flex-direction:column;gap:8px;min-width:0"><span style="font-weight:800;font-size:18px">Event City or Address</span><input name="event_location" type="text" autocomplete="street-address" style="width:100%;box-sizing:border-box;height:56px;border:2px solid #d5dbe5;border-radius:14px;padding:0 16px;font-family:inherit;font-size:18px;color:#182B49;background:#fff"></label>
<label style="display:flex;flex-direction:column;gap:8px;min-width:0"><span style="font-weight:800;font-size:18px">Message</span><textarea name="message" rows="5" style="width:100%;box-sizing:border-box;height:56px;border:2px solid #d5dbe5;border-radius:14px;padding:0 16px;font-family:inherit;font-size:18px;color:#182B49;background:#fff;height:auto;padding:14px 16px;resize:vertical"></textarea></label>
<button type="submit" style="cursor:pointer;border:0;font-family:inherit;background:#FF7518;color:#182B49;font-weight:800;text-align:center;padding:16px 28px;border-radius:14px;font-size:18px;text-transform:uppercase">Send My Request</button>
<p style="margin:0;font-size:18px;line-height:1.5">We'll get back to you as soon as possible. Need a faster answer? Text us at <a href="tel:+14175592347" style="color:#0875D1;font-weight:800;text-decoration:none">(417) 559-2347</a>.</p>
</form>
</div>
<div style="display:flex;flex-direction:column;gap:24px">
<div style="position:relative;margin-top:26px;background:#182B49;color:#fff;border-radius:28px;padding:32px;display:flex;flex-direction:column;gap:22px;border-top:10px solid #FF7518">
<div style="position:absolute;left:30px;right:30px;bottom:calc(100% + 9px);height:18px;overflow:hidden;display:flex;justify-content:center;pointer-events:none">
<div style="flex:none;width:36px;height:36px;border-radius:50%;background:#FF7518;margin-top:8px;">
</div>
<div style="flex:none;width:36px;height:36px;border-radius:50%;background:#FF7518;margin-top:3px;margin-left:-8px">
</div>
<div style="flex:none;width:36px;height:36px;border-radius:50%;background:#FF7518;margin-top:6px;margin-left:-8px">
</div>
<div style="flex:none;width:36px;height:36px;border-radius:50%;background:#FF7518;margin-top:0px;margin-left:-8px">
</div>
<div style="flex:none;width:36px;height:36px;border-radius:50%;background:#FF7518;margin-top:5px;margin-left:-8px">
</div>
<div style="flex:none;width:36px;height:36px;border-radius:50%;background:#FF7518;margin-top:1px;margin-left:-8px">
</div>
<div style="flex:none;width:36px;height:36px;border-radius:50%;background:#FF7518;margin-top:7px;margin-left:-8px">
</div>
<div style="flex:none;width:36px;height:36px;border-radius:50%;background:#FF7518;margin-top:3px;margin-left:-8px">
</div>
<div style="flex:none;width:36px;height:36px;border-radius:50%;background:#FF7518;margin-top:8px;margin-left:-8px">
</div>
</div>
<div style="display:flex;gap:16px;align-items:center">
<div style="flex:none;width:52px;height:52px;border-radius:50%;background:#FF7518;display:flex;align-items:center;justify-content:center"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6.600 10.800a15.100 15.100 0 0 0 6.600 6.600l2.200-2.200a1 1 0 0 1 1-.25 11.400 11.400 0 0 0 3.600.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.500a1 1 0 0 1 1 1c0 1.250.2 2.450.57 3.570a1 1 0 0 1-.25 1z"></path></svg>
</div>
<div style="min-width:0">
<div style="font-weight:700;font-size:18px;opacity:.9">Call or Text</div>
<div style="font-size:18px;line-height:1.45;word-break:break-word"><a href="tel:+14175592347" style="color:#fff;font-weight:800;text-decoration:none">(417) 559-2347</a>
</div>
<div style="font-size:18px;line-height:1.45;color:#fff">Texting is the fastest way to reach us.</div>
</div>
</div>
<div style="display:flex;gap:16px;align-items:center">
<div style="flex:none;width:52px;height:52px;border-radius:50%;background:#FF7518;display:flex;align-items:center;justify-content:center"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="M3 7l9 6 9-6"></path></svg>
</div>
<div style="min-width:0">
<div style="font-weight:700;font-size:18px;opacity:.9">Email</div>
<div style="font-size:18px;line-height:1.45;word-break:break-word"><a href="mailto:joshuaenglish72@gmail.com" style="color:#fff;font-weight:800;text-decoration:none">joshuaenglish72@gmail.com</a>
</div>
</div>
</div>
<div style="display:flex;gap:16px;align-items:center">
<div style="flex:none;width:52px;height:52px;border-radius:50%;background:#FF7518;display:flex;align-items:center;justify-content:center"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.200-7-11.500a7 7 0 0 1 14 0C19 14.800 12 21 12 21z"></path><circle cx="12" cy="9.500" r="2.500"></circle></svg>
</div>
<div style="min-width:0">
<div style="font-weight:700;font-size:18px;opacity:.9">Based in</div>
<div style="font-size:18px;line-height:1.45;word-break:break-word">Forsyth, Missouri</div>
</div>
</div>
<div style="display:flex;gap:16px;align-items:center">
<div style="flex:none;width:52px;height:52px;border-radius:50%;background:#FF7518;display:flex;align-items:center;justify-content:center"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"></path></svg>
</div>
<div style="min-width:0">
<div style="font-weight:700;font-size:18px;opacity:.9">Serving</div>
<div style="font-size:18px;line-height:1.45;word-break:break-word">Branson, Springfield and Southwest Missouri</div>
</div>
</div><a href="/build-your-party/" style="background:#FF7518;color:#182B49;font-weight:800;text-decoration:none;text-align:center;padding:16px 28px;border-radius:14px;font-size:18px;text-transform:uppercase">Build Your Party</a>
</div>
<div style="aspect-ratio:4/3;border-radius:28px;background:repeating-linear-gradient(135deg,#dbeafe 0 16px,#c7dcf3 16px 32px);display:flex;flex-direction:column;gap:8px;align-items:center;justify-content:center;padding:24px;text-align:center;color:#182B49">
<div style="font-family:'Archivo Black',sans-serif;font-size:22px;text-transform:uppercase;color:#0875D1">Map Placeholder</div>
<div style="font-size:18px;line-height:1.4">Forsyth / Branson / Springfield area</div>
</div>
</div>
</div>
</div>
</section>
</Base>
