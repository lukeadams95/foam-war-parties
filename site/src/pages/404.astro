---
import Base from '../layouts/Base.astro';
---
<Base title="Page Not Found | Foam War Parties" description="That page is not on the Foam War Parties site. Head home or build your party." active={null} noindex>
<section style="position:relative;background:#182B49;color:#fff;padding:20px 0 36px;overflow:hidden;min-height:300px;display:flex;align-items:center"><img src="/images/foam-lineart.png" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;filter:invert(1);mix-blend-mode:screen;opacity:.13">
<div style="position:absolute;inset:0;background:radial-gradient(ellipse 60% 55% at 50% 38%,rgba(14,26,46,.92) 0%,rgba(14,26,46,.6) 55%,rgba(14,26,46,0) 100%)">
</div>
<div style="position:relative;max-width:1200px;width:100%;box-sizing:border-box;margin:0 auto;padding:0 var(--padx);width:100%;text-align:center">
<h1 style="font-family:'Archivo Black',sans-serif;font-size:clamp(40px,7vw,64px);line-height:1;margin:0;text-transform:uppercase;text-shadow:0 3px 6px rgba(10,20,38,.6)">Page <span style="color:#FF7518;text-shadow:0 0 6px rgba(255,117,24,.28),0 0 12px rgba(255,117,24,.16)">Not Found</span></h1>
</div>
</section>
<section style="background:#F3F4F6;color:#182B49;padding:72px 0">
<div style="max-width:720px;width:100%;box-sizing:border-box;margin:0 auto;padding:0 var(--padx);text-align:center">
<p style="font-size:clamp(18px,2.4vw,24px);line-height:1.45;text-wrap:pretty;margin:0 0 32px">We cannot find that page. Head home, or start building your foam war party.</p>
<div style="display:flex;flex-wrap:wrap;gap:16px;justify-content:center">
<a href="/" style="color:#182B49;text-align:center;font-weight:800;font-size:18px;text-decoration:none;padding:16px 28px;border:2px solid #182B49;border-radius:14px">Home</a>
<a href="/build-your-party/" style="background:#FF7518;color:#182B49;font-weight:800;text-decoration:none;text-align:center;padding:16px 28px;border-radius:14px;font-size:18px;text-transform:uppercase">Build Your Party</a>
</div>
</div>
</section>
</Base>
